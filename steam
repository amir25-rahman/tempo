# -----------------------------------------------------------------------------
# 2. SQL Parsing Engine
# -----------------------------------------------------------------------------

def get_with_clause(select_expr):
    """sqlglot renamed the 'with' arg key to 'with_' in newer releases.
    Support both so this works across sqlglot versions."""
    return select_expr.args.get("with_") or select_expr.args.get("with")


def get_from_clause(select_expr):
    """sqlglot renamed the 'from' arg key to 'from_' in newer releases.
    Support both so this works across sqlglot versions."""
    return select_expr.args.get("from_") or select_expr.args.get("from")


def sanitize_placeholders(sql_str):
    pattern = r"\$\[([a-zA-Z0-9_]+)\]"
    return re.sub(pattern, r"'PLACEHOLDER_\1'", sql_str)

def classify_transform_and_rename(orig_col, target_col, source_expr, is_alias):
    has_agg = bool(source_expr.find(exp.AggFunc))
    source_cols = list(source_expr.find_all(exp.Column))

    if has_agg:
        return "AGGREGATION", f"AGGREGATION ({source_expr.sql()})"
    elif isinstance(source_expr, exp.Column):
        if orig_col != target_col:
            return "RENAME", f"RENAMED ({orig_col} -> {target_col})"
        else:
            return "DIRECT_COPY", "DIRECT_COPY"
    elif source_cols:
        return "CALCULATED_EXPRESSION", f"CALCULATED ({source_expr.sql()})"
    else:
        return "CONSTANT", f"CONSTANT ({source_expr.sql()})"

def get_clean_table_map(select_expr):
    """Maps table aliases (e.g. 'rs', 'si') to actual table or CTE names as clean strings.

    Only scans the FROM and JOIN clauses that belong to this exact SELECT.
    Using select_expr.find_all(exp.Table) would also recurse into any WITH
    clause attached to this same Select node (sqlglot stores 'with_' as an
    arg on the Select itself), pulling in unrelated table names from CTE
    bodies and corrupting the 'single table' fallback used below.
    """
    tables_map = {}

    def register(tbl):
        real_name = str(tbl.name) if tbl.name else ""
        alias_name = str(tbl.alias_or_name) if tbl.alias else ""
        if real_name:
            tables_map[real_name] = real_name
            if alias_name:
                tables_map[alias_name] = real_name

    from_clause = get_from_clause(select_expr)
    if from_clause:
        for tbl in from_clause.find_all(exp.Table):
            register(tbl)

    for join in select_expr.args.get("joins", []):
        for tbl in join.find_all(exp.Table):
            register(tbl)

    return tables_map

def parse_sql_query(sql_query):
    if not sql_query or not sql_query.strip():
        return None, None, None, "Please enter a SQL query to visualize."

    sanitized = sanitize_placeholders(sql_query)
    try:
        parsed = parse_one(sanitized)
    except Exception as e:
        return None, None, None, f"SQL Parsing Error: {str(e)}"

    if not parsed:
        return None, None, None, "Unable to parse SQL string."

    if not isinstance(parsed, exp.Select):
        return None, None, None, (
            f"This tool visualizes SELECT-based lineage. Detected a "
            f"'{type(parsed).__name__}' statement instead, which isn't supported."
        )

    mappings = []
    query_structure = {"joins": [], "filters": [], "group_by": []}
    cte_names = set()

    # Track CTE names
    with_clause = get_with_clause(parsed)
    if with_clause:
        for cte in with_clause.expressions:
            cte_name = str(cte.alias_or_name or cte.alias or cte.name)
            cte_names.add(cte_name)

    def extract_scope_details(select_expr, scope_name):
        if not isinstance(select_expr, exp.Select):
            return

        # 1. Recursively extract subqueries in FROM / JOIN
        from_clause = get_from_clause(select_expr)
        if from_clause and from_clause.this:
            if isinstance(from_clause.this, (exp.Subquery, exp.Select)):
                sub_select = from_clause.this.this if isinstance(from_clause.this, exp.Subquery) else from_clause.this
                sub_alias = str(from_clause.this.alias_or_name or f"SUBQUERY_{scope_name}")
                extract_scope_details(sub_select, scope_name=sub_alias)

        for join in select_expr.args.get("joins", []):
            j_this = join.this
            if isinstance(j_this, (exp.Subquery, exp.Select)):
                sub_select = j_this.this if isinstance(j_this, exp.Subquery) else j_this
                sub_alias = str(j_this.alias_or_name or f"SUBQUERY_{scope_name}")
                extract_scope_details(sub_select, scope_name=sub_alias)

        tables_map = get_clean_table_map(select_expr)

        # 2. Extract Joins Logic
        for join in select_expr.args.get("joins", []):
            j_tbl = join.this
            j_name = j_tbl.name if isinstance(j_tbl, exp.Table) else j_tbl.sql()
            j_alias = str(j_tbl.alias_or_name) if hasattr(j_tbl, "alias_or_name") else ""
            
            resolved_j_name = tables_map.get(j_alias, tables_map.get(j_name, j_name))

            query_structure["joins"].append({
                "Scope": scope_name,
                "Join Type": join.args.get("side", "INNER") or "INNER",
                "Table": j_tbl.sql(),
                "Joined Name": resolved_j_name,
                "Joined Alias": j_alias,
                "On Condition": join.args.get("on").sql() if join.args.get("on") else "N/A"
            })

        # 3. Extract WHERE Filters
        where_clause = select_expr.args.get("where")
        if where_clause:
            query_structure["filters"].append({
                "Scope": scope_name,
                "Condition": where_clause.this.sql()
            })

        # 4. Extract GROUP BY
        group_clause = select_expr.args.get("group")
        if group_clause:
            query_structure["group_by"].append({
                "Scope": scope_name,
                "Group Keys": [g.sql() for g in group_clause.expressions]
            })

        # 5. Extract Column Level Transformations
        for expression in select_expr.expressions:
            is_alias = False
            if isinstance(expression, exp.Star):
                # SELECT * has no individual column mapping to trace - surface it
                # explicitly instead of misclassifying it as a literal/constant.
                mappings.append({
                    "Source Table": "ALL_COLUMNS",
                    "Original Column": "*",
                    "Target Scope": scope_name,
                    "Target Column": "*",
                    "Transform Type": "PASSTHROUGH_STAR",
                    "Rename Indicator": "SELECT * (all upstream columns pass through unchanged)",
                    "Expression": "*"
                })
                continue
            if isinstance(expression, exp.Alias):
                target_col = str(expression.alias)
                source_expr = expression.this
                is_alias = True
            elif isinstance(expression, exp.Column):
                target_col = str(expression.name)
                source_expr = expression
            else:
                target_col = str(expression.sql())
                source_expr = expression

            source_cols = list(source_expr.find_all(exp.Column))

            if not source_cols:
                transform_type, rename_indicator = classify_transform_and_rename(
                    orig_col=source_expr.sql(),
                    target_col=target_col,
                    source_expr=source_expr,
                    is_alias=is_alias
                )
                mappings.append({
                    "Source Table": "LITERAL/EXPRESSION",
                    "Original Column": source_expr.sql(),
                    "Target Scope": scope_name,
                    "Target Column": target_col,
                    "Transform Type": transform_type,
                    "Rename Indicator": rename_indicator,
                    "Expression": source_expr.sql()
                })
            else:
                for col in source_cols:
                    table_ref = str(col.table) if col.table else ""
                    if table_ref:
                        resolved_table = tables_map.get(table_ref, table_ref)
                    else:
                        unique_tables = list(set(tables_map.values()))
                        resolved_table = unique_tables[0] if len(unique_tables) == 1 else "UNKNOWN"

                    orig_col_name = str(col.name)

                    transform_type, rename_indicator = classify_transform_and_rename(
                        orig_col=orig_col_name,
                        target_col=target_col,
                        source_expr=source_expr,
                        is_alias=is_alias
                    )

                    mappings.append({
                        "Source Table": resolved_table,
                        "Original Column": orig_col_name,
                        "Target Scope": scope_name,
                        "Target Column": target_col,
                        "Transform Type": transform_type,
                        "Rename Indicator": rename_indicator,
                        "Expression": source_expr.sql()
                    })

    try:
        # Execute CTE Extraction
        if with_clause:
            for cte in with_clause.expressions:
                cte_scope_name = str(cte.alias_or_name or cte.alias or cte.name)
                if isinstance(cte.this, exp.Select):
                    extract_scope_details(cte.this, scope_name=cte_scope_name)

        # Execute Final Output SELECT Extraction
        extract_scope_details(parsed, scope_name="FINAL_OUTPUT")
    except Exception as e:
        return None, None, None, (
            f"Unexpected error while analyzing query structure: {str(e)}. "
            f"This can happen with SQL constructs (e.g. window functions, "
            f"UNION, nested CTEs) not yet supported by this visualizer."
        )

    if not mappings:
        return None, None, None, (
            "No column-level mappings were found. The query parsed successfully "
            "but produced no traceable SELECT expressions."
        )

    df = pd.DataFrame(mappings).drop_duplicates().reset_index(drop=True)
    return df, query_structure, cte_names, None

# -----------------------------------------------------------------------------
# 3. Directed Multi-Hop Lineage Filtering Engine
# -----------------------------------------------------------------------------
def filter_df_by_selected_lineage(df, selected_node_id):
    if not selected_node_id:
        return df

    upstream_nodes = {selected_node_id}
    added = True
    while added:
        added = False
        for _, row in df.iterrows():
            src_id = f"{row['Source Table']}.{row['Original Column']}"
            tgt_id = f"{row['Target Scope']}.{row['Target Column']}"
            if tgt_id in upstream_nodes and src_id not in upstream_nodes:
                upstream_nodes.add(src_id)
                added = True

    downstream_nodes = {selected_node_id}
    added = True
    while added:
        added = False
        for _, row in df.iterrows():
            src_id = f"{row['Source Table']}.{row['Original Column']}"
            tgt_id = f"{row['Target Scope']}.{row['Target Column']}"
            if src_id in downstream_nodes and tgt_id not in downstream_nodes:
                downstream_nodes.add(tgt_id)
                added = True

    def is_lineage_row(row):
        src_id = f"{row['Source Table']}.{row['Original Column']}"
        tgt_id = f"{row['Target Scope']}.{row['Target Column']}"
        return ((src_id in upstream_nodes) and (tgt_id in upstream_nodes)) or \
               ((src_id in downstream_nodes) and (tgt_id in downstream_nodes))

    mask = df.apply(is_lineage_row, axis=1)
    return df[mask]

def sort_df_pin_node_to_top(df, pin_node_id):
    """Keep every row visible (unlike filter_df_by_selected_lineage, which
    drops unrelated rows) but reorder so rows directly touching pin_node_id
    - as either source or target - float to the top. Used for the
    click-to-pin interaction while the graph view is locked, so a hop can be
    traced in the table without losing the rest of the lineage context."""
    if df is None or df.empty or not pin_node_id:
        return df

    def touches_pin(row):
        src_id = f"{row['Source Table']}.{row['Original Column']}"
        tgt_id = f"{row['Target Scope']}.{row['Target Column']}"
        return src_id == pin_node_id or tgt_id == pin_node_id

    is_pinned = df.apply(touches_pin, axis=1)
    return pd.concat([df[is_pinned], df[~is_pinned]], ignore_index=True)

def filter_structural_logic(structure, table_df):
    if table_df is None or table_df.empty:
        return {"joins": [], "filters": [], "group_by": []}

    active_target_scopes = set(table_df["Target Scope"].unique())
    active_source_tables = set(table_df["Source Table"].unique())

    filtered_joins = []
    for j in structure["joins"]:
        if j["Scope"] in active_target_scopes:
            j_name = j.get("Joined Name", "")
            j_alias = j.get("Joined Alias", "")
            if j_name in active_source_tables or j_alias in active_source_tables:
                filtered_joins.append({
                    "Scope": j["Scope"],
                    "Join Type": j["Join Type"],
                    "Table": j["Table"],
                    "On Condition": j["On Condition"]
                })

    filtered_filters = [
        {"Scope": f["Scope"], "Condition": f["Condition"]}
        for f in structure["filters"] if f["Scope"] in active_target_scopes
    ]

    filtered_group_by = [
        {"Scope": g["Scope"], "Group Keys": g["Group Keys"]}
        for g in structure["group_by"] if g["Scope"] in active_target_scopes
    ]

    return {
        "joins": filtered_joins,
        "filters": filtered_filters,
        "group_by": filtered_group_by
    }

# -----------------------------------------------------------------------------
# 4. Streamlit UI
# -----------------------------------------------------------------------------
sql_input = st.text_area("SQL Query Input", value=DEFAULT_SQL, height=220)

if not sql_input.strip():
    st.info("Enter a SQL query above to visualize its lineage.")
else:
    df_mappings, structure, cte_names, error = parse_sql_query(sql_input)

    if error:
        st.error(error)
    elif df_mappings is None or df_mappings.empty:
        st.warning("No lineage could be extracted from this query.")
    else:

        def truncate_label(text, max_chars):
            text = str(text)
            if len(text) <= max_chars:
                return text
            return text[:max_chars - 1].rstrip() + "…"

        NODE_LABEL_MAX_CHARS = 22

        nodes = []
        edges = []
        added_parents = set()
        added_nodes = set()

        for idx, row in df_mappings.iterrows():
            src_parent = f"parent_{row['Source Table']}"
            tgt_parent = f"parent_{row['Target Scope']}"
            
            src_node_id = f"{row['Source Table']}.{row['Original Column']}"
            tgt_node_id = f"{row['Target Scope']}.{row['Target Column']}"

            # Label Containers
            if row['Source Table'] == 'FINAL_OUTPUT':
                src_label = "Output: FINAL_OUTPUT"
            elif row['Source Table'] in cte_names:
                src_label = f"CTE: {row['Source Table']}"
            else:
                src_label = f"Table: {row['Source Table']}"

            if row['Target Scope'] == 'FINAL_OUTPUT':
                tgt_label = "Output: FINAL_OUTPUT"
            elif row['Target Scope'] in cte_names:
                tgt_label = f"CTE: {row['Target Scope']}"
            else:
                tgt_label = f"Table: {row['Target Scope']}"

            if src_parent not in added_parents:
                nodes.append({"data": {"id": src_parent, "label": src_label, "isParent": True}})
                added_parents.add(src_parent)
            
            if tgt_parent not in added_parents:
                nodes.append({"data": {"id": tgt_parent, "label": tgt_label, "isParent": True}})
                added_parents.add(tgt_parent)

            if src_node_id not in added_nodes:
                nodes.append({"data": {
                    "id": src_node_id,
                    "label": truncate_label(row['Original Column'], NODE_LABEL_MAX_CHARS),
                    "fullLabel": str(row['Original Column']),
                    "parent": src_parent
                }})
                added_nodes.add(src_node_id)

            if tgt_node_id not in added_nodes:
                nodes.append({"data": {
                    "id": tgt_node_id,
                    "label": truncate_label(row['Target Column'], NODE_LABEL_MAX_CHARS),
                    "fullLabel": str(row['Target Column']),
                    "parent": tgt_parent
                }})
                added_nodes.add(tgt_node_id)

            if row['Transform Type'] == 'RENAME':
                edge_label = f"RENAME ({row['Original Column']} -> {row['Target Column']})"
            elif row['Transform Type'] == 'AGGREGATION':
                edge_label = f"AGGREGATION ({row['Expression']})"
            elif row['Transform Type'] == 'CALCULATED_EXPRESSION':
                edge_label = f"CALCULATED ({row['Expression']})"
            else:
                edge_label = row['Transform Type']

            # Long expressions (e.g. CASE WHEN..., nested functions) make the
            # on-canvas edge label unreadable and cause overlap with neighboring
            # elements. Show a truncated version on the graph and keep the full
            # text available via the node/edge tooltip (title on hover).
            full_edge_label = edge_label
            edge_label = truncate_label(edge_label, 42)

            edges.append({
                "data": {
                    "id": f"e_{idx}",
                    "source": src_node_id,
                    "target": tgt_node_id,
                    "label": edge_label,
                    "fullLabel": full_edge_label
                }
            })

        st.subheader("1. Interactive Visual Lineage")
        # Python's built-in hash() is randomized per-process (PYTHONHASHSEED),
        # so it would change on every app restart and needlessly reset the
        # component's selection state. Use a stable content hash instead.
        stable_hash = hashlib.md5(sql_input.encode("utf-8")).hexdigest()
        comp_key = f"cytoscape_{stable_hash}"
        component_value = cytoscape_component(elements={"nodes": nodes, "edges": edges}, key=comp_key)

        # The component sends either a plain node-id string (normal isolate
        # click - hard-filter the tabs to just that lineage path) or a
        # {nodeId, mode: 'pin'} object (a click while the graph view is
        # locked - keep every row visible, just float that node's rows to
        # the top so it's easy to spot without losing the rest of the
        # context).
        selected_node_id = None
        pin_node_id = None
        if isinstance(component_value, dict):
            pin_node_id = component_value.get("nodeId")
        elif component_value:
            selected_node_id = component_value

        st.subheader("2. Synced Interactive Schema Details")

        if selected_node_id:
            st.info(f"Filtering all tabs for lineage path of: **`{selected_node_id}`**")
            table_df = filter_df_by_selected_lineage(df_mappings, selected_node_id)
            filtered_structure = filter_structural_logic(structure, table_df)
        elif pin_node_id:
            st.info(f"Pinned to top: **`{pin_node_id}`** (locked view - showing all rows, this node's first)")
            table_df = sort_df_pin_node_to_top(df_mappings, pin_node_id)
            filtered_structure = structure
        else:
            table_df = df_mappings
            filtered_structure = structure

        tab1, tab2, tab3 = st.tabs(["Column Transformations", "Joins Logic", "Filters & Groupings"])

        with tab1:
            search_col, download_col = st.columns([3, 1])
            with search_col:
                search_term = st.text_input(
                    "Search transformations",
                    placeholder="Filter by table, column, or expression…",
                    label_visibility="collapsed"
                )

            display_df = table_df
            if search_term:
                mask = table_df.apply(
                    lambda row: row.astype(str).str.contains(search_term, case=False, regex=False).any(),
                    axis=1
                )
                display_df = table_df[mask]

            with download_col:
                st.download_button(
                    "Download CSV",
                    data=display_df.to_csv(index=False).encode("utf-8"),
                    file_name="sql_lineage_mappings.csv",
                    mime="text/csv",
                    use_container_width=True
                )

            if search_term and display_df.empty:
                st.info(f"No transformations match '{search_term}'.")
            else:
                st.dataframe(display_df, use_container_width=True, hide_index=True)

        with tab2:
            if filtered_structure["joins"]:
                st.dataframe(pd.DataFrame(filtered_structure["joins"]), use_container_width=True, hide_index=True)
            else:
                st.info("No relevant JOIN clauses for this selection.")

        with tab3:
            col_a, col_b = st.columns(2)
            with col_a:
                st.markdown("#### WHERE Filter Conditions")
                if filtered_structure["filters"]:
                    st.dataframe(pd.DataFrame(filtered_structure["filters"]), use_container_width=True, hide_index=True)
                else:
                    st.info("No relevant WHERE filters for this selection.")

            with col_b:
                st.markdown("#### GROUP BY Clauses")
                if filtered_structure["group_by"]:
                    st.dataframe(pd.DataFrame(filtered_structure["group_by"]), use_container_width=True, hide_index=True)
                else:
                    st.info("No relevant GROUP BY clauses for this selection.")









