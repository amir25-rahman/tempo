            width: 200px;
        }}
        .controls label {{ font-size: 12px; font-weight: 500; color: #1E293B; cursor: pointer; }}
        .controls button {{
            background: #2563EB; color: white; border: none;
            padding: 6px 12px; border-radius: 6px; font-weight: 500;
