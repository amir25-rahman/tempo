import json
import os
import webbrowser
import sqlglot
from sqlglot import exp

def generate_isolated_dremio_lineage(sql_query: str, output_filename: str = "dremio_lineage_isolated_app.html"):
    """
    Generates an enterprise-scale Dremio SQL Lineage & Transformation app featuring:
    - Target Node Locking (Pin & Trace strict ancestry without sibling clutter)
    - Reliable Collapsible Bottom Table for full-screen graph inspection
    - Dynamic Dagre Re-Layout on subgraph isolation (no empty gaps)
    - Parent Table/Stage visual container highlighting on cell/node selection
    """
    parsed = sqlglot.parse_one(sql_query, read="trino")
    
    nodes = {}
    edges = {}
    table_rows = []
    
    cte_dict = {cte.alias_or_name: cte for cte in parsed.find_all(exp.CTE)}
    cte_names = set(cte_dict.keys())

    def get_scope_alias_map(subquery):
        """Maps table aliases (e.g., 'c', 'r') to their true table/CTE names within a scope."""
        alias_map = {}
        for table in subquery.find_all(exp.Table):
            real_name = table.name
            alias = table.alias or real_name
            alias_map[alias] = real_name
        return alias_map

    def resolve_table_ref(col_ref, alias_map):
        """Resolves a column's parent table using the scope's alias mapping."""
        if col_ref.table:
            return alias_map.get(col_ref.table, col_ref.table)
        if len(alias_map) == 1:
            return next(iter(alias_map.values()))
        return "UNKNOWN_SOURCE"

    def add_table_and_column(table_name, col_name, stage_type="source", formula=None, filter_str=None, inputs=None):
        if table_name not in nodes:
            nodes[table_name] = {
                "data": {
                    "id": table_name,
                    "label": f"{table_name.upper()} ({stage_type.upper()})",
                    "type": "container",
                    "stage": stage_type
                }
            }
            
        col_id = f"{table_name}.{col_name}"
        if col_id not in nodes:
            is_transformed = bool(formula)
            display_label = f"{col_name} [fx]" if is_transformed else col_name
            
            nodes[col_id] = {
                "data": {
                    "id": col_id,
                    "parent": table_name,
                    "label": display_label,
                    "raw_name": col_name,
                    "formula": formula or "Direct Column Mapping",
                    "filter": filter_str or "None",
                    "table": table_name,
                    "stage": stage_type,
                    "is_transformed": is_transformed,
                    "source_inputs": inputs or [col_name]
                }
            }
            
            table_rows.append({
                "id": col_id,
                "target_col": col_name,
                "parent_table": table_name,
                "stage": stage_type.upper(),
                "source_inputs": inputs or [col_name],
                "formula": formula or "Direct Mapping",
                "filter_scope": filter_str or "None",
                "is_transformed": is_transformed
            })
            
        return col_id

    def add_edge(source_id, target_id, edge_type, label=""):
        edge_id = f"{edge_type}:{source_id}->{target_id}"
        if edge_id not in edges:
            edges[edge_id] = {
                "data": {
                    "id": edge_id,
                    "source": source_id,
                    "target": target_id,
                    "type": edge_type,
                    "label": label
                }
            }

    # 1. Process CTE Transformations
    for cte_name, cte in cte_dict.items():
        subquery = cte.this
        if not isinstance(subquery, exp.Select):
            continue
            
        alias_map = get_scope_alias_map(subquery)
        where_clause = subquery.args.get("where")
        filter_str = where_clause.this.sql() if where_clause else None

        # Capture column transformations
        for expression in subquery.selects:
            col_alias = expression.alias_or_name
            raw_sql = expression.sql()
            is_calc = (col_alias != raw_sql) and any(token in raw_sql for token in ("(", "+", "-", "*", "/", "||"))
            source_cols = [c.name for c in expression.find_all(exp.Column)]
            
            target_id = add_table_and_column(
                table_name=cte_name, 
                col_name=col_alias, 
                stage_type="cte", 
                formula=raw_sql if is_calc else None, 
                filter_str=filter_str,
                inputs=source_cols
            )
            
            for col_ref in expression.find_all(exp.Column):
                real_table = resolve_table_ref(col_ref, alias_map)
                src_id = add_table_and_column(
                    table_name=real_table,
                    col_name=col_ref.name,
                    stage_type="cte" if real_table in cte_names else "source"
                )
                
                edge_type = "transformation" if is_calc else "direct"
                add_edge(src_id, target_id, edge_type, "fx" if is_calc else "")

        # Capture Join relational conditions
        for join in subquery.find_all(exp.Join):
            on_clause = join.args.get("on")
            if on_clause:
                cols = list(on_clause.find_all(exp.Column))
                if len(cols) >= 2:
                    t1 = resolve_table_ref(cols[0], alias_map)
                    t2 = resolve_table_ref(cols[1], alias_map)
                    n1 = add_table_and_column(t1, cols[0].name, "cte" if t1 in cte_names else "source")
                    n2 = add_table_and_column(t2, cols[1].name, "cte" if t2 in cte_names else "source")
                    add_edge(n1, n2, "join", "JOIN ON")

    # 2. Process Final Output SELECT
    if isinstance(parsed, exp.Select):
        alias_map = get_scope_alias_map(parsed)
        where_clause = parsed.args.get("where")
        filter_str = where_clause.this.sql() if where_clause else None

        for expression in parsed.selects:
            out_col = expression.alias_or_name
            raw_sql = expression.sql()
            is_calc = (out_col != raw_sql) and any(token in raw_sql for token in ("(", "+", "-", "*", "/", "||"))
            source_cols = [c.name for c in expression.find_all(exp.Column)]
            
            target_id = add_table_and_column(
                table_name="FINAL_OUTPUT",
                col_name=out_col,
                stage_type="output",
                formula=raw_sql if is_calc else None,
                filter_str=filter_str,
                inputs=source_cols
            )
            
            for col_ref in expression.find_all(exp.Column):
                real_table = resolve_table_ref(col_ref, alias_map)
                src_id = add_table_and_column(
                    table_name=real_table,
                    col_name=col_ref.name,
                    stage_type="cte" if real_table in cte_names else "source"
                )
                
                edge_type = "transformation" if is_calc else "direct"
                add_edge(src_id, target_id, edge_type, "fx" if is_calc else "")

        # Capture Top-Level Joins
        for join in parsed.find_all(exp.Join):
            on_clause = join.args.get("on")
            if on_clause:
                cols = list(on_clause.find_all(exp.Column))
                if len(cols) >= 2:
                    t1 = resolve_table_ref(cols[0], alias_map)
                    t2 = resolve_table_ref(cols[1], alias_map)
                    n1 = add_table_and_column(t1, cols[0].name, "cte" if t1 in cte_names else "source")
                    n2 = add_table_and_column(t2, cols[1].name, "cte" if t2 in cte_names else "source")
                    add_edge(n1, n2, "join", "JOIN ON")

    graph_elements = {
        "nodes": list(nodes.values()),
        "edges": list(edges.values())
    }

    # 3. HTML + Cytoscape.js + Interactive Lineage App Template
    html_template = f"""<!DOCTYPE html>
