    sample_dremio_sql = """
WITH

-- Step 1: Filter and enrich raw orders within the reporting window
filtered_orders AS (
    SELECT
        o.order_id,
        o.customer_id,
        o.order_date,
        o.status,
        o.channel,
        o.promotion_id,
        o.shipping_address_id,
        DATE_TRUNC('month', o.order_date) AS order_month
    FROM
        sales.orders o
    WHERE
        o.order_date >= '2024-01-01'
        AND o.order_date < '2025-01-01'
        AND o.status NOT IN ('CANCELLED', 'FRAUD')
),

-- Step 2: Aggregate order line items to order level
order_totals AS (
    SELECT
        oi.order_id,
        COUNT(oi.line_item_id)                          AS line_item_count,
        SUM(oi.quantity)                                AS total_units,
        SUM(oi.unit_price * oi.quantity)                AS gross_revenue,
        SUM(oi.discount_amount)                         AS total_discounts,
        SUM((oi.unit_price * oi.quantity) - oi.discount_amount) AS net_revenue
    FROM
        sales.order_items oi
    INNER JOIN
        filtered_orders fo ON fo.order_id = oi.order_id
    GROUP BY
        oi.order_id
),

-- Step 3: Pull customer demographic and segment data
customer_profile AS (
    SELECT
        c.customer_id,
        c.first_name,
        c.last_name,
        c.email,
        c.acquisition_channel,
        c.signup_date,
        cs.segment_name,
        cs.lifetime_value_tier,
        cs.churn_risk_score
    FROM
        customers.accounts c
    LEFT JOIN
        customers.segments cs ON cs.customer_id = c.customer_id
),

-- Step 4: Resolve promotion details and compute discount rates
promotion_summary AS (
    SELECT
        p.promotion_id,
        p.promotion_name,
        p.promotion_type,
        p.discount_rate,
        p.start_date,
        p.end_date,
        p.budget_allocated,
        SUM(ot.total_discounts) AS total_discount_redeemed,
        COUNT(DISTINCT fo.order_id) AS orders_using_promo
    FROM
        marketing.promotions p
    LEFT JOIN
        filtered_orders fo ON fo.promotion_id = p.promotion_id
    LEFT JOIN
        order_totals ot ON ot.order_id = fo.order_id
    GROUP BY
        p.promotion_id,
        p.promotion_name,
        p.promotion_type,
        p.discount_rate,
        p.start_date,
        p.end_date,
        p.budget_allocated
),

-- Step 5: Join product details with category hierarchy for each line item
product_detail AS (
    SELECT
        oi.order_id,
        oi.line_item_id,
        oi.product_id,
        pr.product_name,
        pr.sku,
        pr.cost_price,
        pc.category_id,
        pc.category_name,
        pc.parent_category_name,
        oi.unit_price,
        oi.quantity,
        (oi.unit_price - pr.cost_price) * oi.quantity AS gross_margin
    FROM
        sales.order_items oi
    INNER JOIN
        filtered_orders fo ON fo.order_id = oi.order_id
    INNER JOIN
        catalog.products pr ON pr.product_id = oi.product_id
    INNER JOIN
        catalog.product_categories pc ON pc.category_id = pr.category_id
),

-- Step 6: Aggregate margin by order
order_margin AS (
    SELECT
        order_id,
        SUM(gross_margin) AS total_gross_margin,
        SUM(cost_price * quantity) AS total_cogs
    FROM
        product_detail
    GROUP BY
        order_id
),

-- Step 7: Resolve shipping carrier and delivery performance
shipping_performance AS (
    SELECT
        s.order_id,
        s.carrier_name,
        s.service_level,
        s.shipped_date,
        s.delivered_date,
        s.promised_delivery_date,
        DATEDIFF(s.delivered_date, s.shipped_date) AS days_in_transit,
        CASE
            WHEN s.delivered_date <= s.promised_delivery_date THEN 'ON_TIME'
            WHEN s.delivered_date IS NULL THEN 'IN_TRANSIT'
            ELSE 'LATE'
        END AS delivery_status,
        s.shipping_cost
    FROM
        logistics.shipments s
    INNER JOIN
        filtered_orders fo ON fo.order_id = s.order_id
),

-- Step 8: Identify orders that had at least one return and compute return value
return_summary AS (
    SELECT
        r.order_id,
        COUNT(r.return_id)          AS return_count,
        SUM(r.refund_amount)        AS total_refunded,
        MAX(r.return_date)          AS last_return_date,
        STRING_AGG(r.return_reason, ', ') AS return_reasons
    FROM
        sales.returns r
    INNER JOIN
        filtered_orders fo ON fo.order_id = r.order_id
    GROUP BY
        r.order_id
),

-- Step 9: Full order fact assembly
order_fact AS (
    SELECT
        fo.order_id,
        fo.order_date,
        fo.order_month,
        fo.channel,
        fo.status,

        -- Customer
        cp.customer_id,
        cp.first_name || ' ' || cp.last_name AS customer_name,
        cp.acquisition_channel,
        cp.segment_name,
        cp.lifetime_value_tier,
        cp.churn_risk_score,

        -- Financials
        ot.gross_revenue,
        ot.total_discounts,
        ot.net_revenue,
        om.total_cogs,
        om.total_gross_margin,
        ROUND(om.total_gross_margin / NULLIF(ot.net_revenue, 0) * 100, 2) AS gross_margin_pct,

        -- Promotion
        ps.promotion_name,
        ps.promotion_type,
        ps.discount_rate AS promo_discount_rate,

        -- Shipping
        sp.carrier_name,
        sp.service_level,
        sp.days_in_transit,
        sp.delivery_status,
        sp.shipping_cost,

        -- Returns
        COALESCE(rs.return_count, 0)     AS return_count,
        COALESCE(rs.total_refunded, 0)   AS total_refunded,
        rs.return_reasons,

        -- Net settled revenue after refunds
        ot.net_revenue - COALESCE(rs.total_refunded, 0) AS settled_revenue,

        ot.line_item_count,
        ot.total_units
    FROM
        filtered_orders fo
    INNER JOIN customer_profile  cp ON cp.customer_id     = fo.customer_id
    INNER JOIN order_totals      ot ON ot.order_id        = fo.order_id
    INNER JOIN order_margin      om ON om.order_id        = fo.order_id
    LEFT JOIN  promotion_summary ps ON ps.promotion_id    = fo.promotion_id
    LEFT JOIN  shipping_performance sp ON sp.order_id     = fo.order_id
    LEFT JOIN  return_summary     rs ON rs.order_id       = fo.order_id
)

-- Step 10: Final rollup, one row per month / channel / segment / category
SELECT
    of.order_month,
    of.channel,
    of.segment_name,
    of.lifetime_value_tier,
    of.promotion_type,
    of.delivery_status,
    pd.parent_category_name,
    pd.category_name,

    COUNT(DISTINCT of.order_id)         AS total_orders,
    COUNT(DISTINCT of.customer_id)      AS unique_customers,
    SUM(of.gross_revenue)               AS gross_revenue,
    SUM(of.total_discounts)             AS total_discounts,
    SUM(of.net_revenue)                 AS net_revenue,
    SUM(of.total_cogs)                  AS total_cogs,
    SUM(of.total_gross_margin)          AS gross_margin,
    ROUND(
        SUM(of.total_gross_margin) / NULLIF(SUM(of.net_revenue), 0) * 100, 2
    )                                   AS gross_margin_pct,
    SUM(of.shipping_cost)               AS total_shipping_cost,
    SUM(of.total_refunded)              AS total_refunded,
    SUM(of.settled_revenue)             AS settled_revenue,
    SUM(of.return_count)                AS total_returns,
    ROUND(
        SUM(of.return_count) * 1.0 / NULLIF(COUNT(DISTINCT of.order_id), 0) * 100, 2
    )                                   AS return_rate_pct,
    ROUND(SUM(of.net_revenue) / NULLIF(COUNT(DISTINCT of.order_id), 0), 2)
                                        AS avg_order_value,
    ROUND(AVG(of.churn_risk_score), 4)  AS avg_churn_risk,
    ROUND(AVG(of.days_in_transit), 1)   AS avg_days_in_transit

FROM
    order_fact of
INNER JOIN
    product_detail pd ON pd.order_id = of.order_id

GROUP BY
    of.order_month,
    of.channel,
    of.segment_name,
    of.lifetime_value_tier,
    of.promotion_type,
    of.delivery_status,
    pd.parent_category_name,
    pd.category_name

ORDER BY
    of.order_month ASC,
    gross_revenue DESC;
    """
    
