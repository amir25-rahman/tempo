                    <button id="lock-btn" onclick="toggleLockNode()">Lock Target (Pin)</button>
                </div>
            </div>
            <div id="table-container">
                <table id="transformation-table">
                    <thead>
                        <tr>
                            <th>Target Column</th>
                            <th>Parent Table / Stage</th>
                            <th>Source Input(s)</th>
                            <th>Transformation Logic / Formula</th>
                            <th>Filter / Join Scope</th>
                        </tr>
                    </thead>
                    <tbody id="table-body">
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        const elements = {json.dumps(graph_elements)};
        const tableData = {json.dumps(table_rows)};
        let activeNodeId = null;
        let lockedNodeId = null;

        const dagreLayoutConfig = {{
            name: 'dagre',
            rankDir: 'LR',
            rankSep: 100,
            nodeSep: 16,
            padding: 40,
            animate: true,
            animationDuration: 350,
            fit: true
        }};

        function runCompactLayout() {{
            const visibleElements = cy.elements().not('.hidden-node');
            const layout = visibleElements.layout(dagreLayoutConfig);
            layout.run();
        }}

        const tbody = document.getElementById("table-body");
        tableData.forEach(row => {{
            const tr = document.createElement("tr");
            tr.id = "row-" + row.id;
            tr.onclick = () => activateLineagePath(row.id);
            
            const badgeClass = row.stage === "SOURCE" ? "badge-source" :
                               row.stage === "CTE" ? "badge-cte" : "badge-output";
            
            tr.innerHTML = `
                <td><b>${{row.target_col}}</b></td>
                <td><span class="badge ${{badgeClass}}">${{row.parent_table}} (${{row.stage}})</span></td>
                <td><code>${{row.source_inputs.join(", ")}}</code></td>
                <td><code>${{row.formula}}</code></td>
                <td><code>${{row.filter_scope}}</code></td>
            `;
            tbody.appendChild(tr);
        }});

        const cy = cytoscape({{
            container: document.getElementById('cy'),
            elements: elements,
            maxZoom: 1.8,
            minZoom: 0.2,
            style: [
                {{
                    selector: 'node[type="container"]',
                    style: {{
                        'label': 'data(label)',
                        'text-valign': 'top',
                        'text-halign': 'center',
                        'font-size': '12px',
                        'font-weight': 'bold',
                        'color': '#475569',
                        'background-color': '#F8FAFC',
                        'border-width': 1,
                        'border-color': '#CBD5E1',
                        'padding': '16px',
                        'shape': 'roundrectangle'
                    }}
                }},
                {{
                    selector: 'node[type="container"].highlighted-parent',
                    style: {{
                        'border-width': 3,
                        'border-color': '#2563EB',
                        'background-color': '#DBEAFE',
                        'box-shadow': '0 0 15px rgba(37,99,235,0.4)'
                    }}
                }},
                {{
                    selector: 'node[parent]',
                    style: {{
                        'label': 'data(label)',
                        'text-valign': 'center',
                        'text-halign': 'center',
                        'font-size': '11px',
                        'font-family': 'monospace',
                        'width': '160px',
                        'height': '32px',
                        'background-color': '#FFFFFF',
                        'border-width': 1,
                        'border-color': '#94A3B8',
                        'shape': 'roundrectangle',
                        'color': '#0F172A'
                    }}
                }},
                {{
                    selector: 'node[stage="source"][parent]',
                    style: {{ 'border-color': '#10B981', 'background-color': '#ECFDF5' }}
                }},
                {{
                    selector: 'node[stage="cte"][parent]',
                    style: {{ 'border-color': '#3B82F6', 'background-color': '#EFF6FF' }}
                }},
                {{
                    selector: 'node[stage="output"][parent]',
                    style: {{ 'border-color': '#F59E0B', 'background-color': '#FFFBEB', 'font-weight': 'bold' }}
                }},
                {{
                    selector: 'edge[type="direct"]',
                    style: {{
                        'width': 1.8,
                        'line-color': '#64748B',
                        'target-arrow-color': '#64748B',
                        'target-arrow-shape': 'triangle',
                        'curve-style': 'bezier'
                    }}
                }},
                {{
                    selector: 'edge[type="transformation"]',
                    style: {{
                        'width': 2.5,
                        'line-color': '#2563EB',
                        'target-arrow-color': '#2563EB',
                        'target-arrow-shape': 'triangle',
                        'curve-style': 'bezier',
                        'label': 'data(label)',
                        'font-size': '9px',
                        'font-weight': 'bold',
                        'color': '#1E40AF',
                        'text-background-color': '#DBEAFE',
                        'text-background-opacity': 1,
                        'text-background-padding': '2px',
                        'text-background-shape': 'roundrectangle'
                    }}
                }},
                {{
                    selector: 'edge[type="join"]',
                    style: {{
                        'width': 1.5,
                        'line-color': '#9333EA',
                        'line-style': 'dashed',
                        'curve-style': 'bezier',
                        'label': 'data(label)',
                        'font-size': '9px',
                        'color': '#6B21A8',
                        'text-background-color': '#FAF5FF',
                        'text-background-opacity': 1,
                        'text-background-padding': '2px'
                    }}
                }},
                {{ selector: '.dimmed', style: {{ 'opacity': 0.15 }} }},
                {{ selector: '.hidden-node', style: {{ 'display': 'none' }} }},
                {{
                    selector: '.highlighted',
                    style: {{
                        'border-width': 2.5,
                        'border-color': '#2563EB',
                        'box-shadow': '0 0 10px rgba(37,99,235,0.3)'
                    }}
                }},
                {{
                    selector: '.locked-target',
                    style: {{
                        'border-width': 3,
                        'border-color': '#D97706',
                        'background-color': '#FEF3C7',
                        'box-shadow': '0 0 14px rgba(217,119,6,0.6)'
                    }}
                }}
            ],
            layout: dagreLayoutConfig
        }});

        function toggleBottomPanel() {{
            const cyEl = document.getElementById("cy");
            const panel = document.getElementById("bottom-panel");
            const btn = document.getElementById("table-toggle-btn");
            
            const isCollapsed = panel.classList.toggle("collapsed");
            cyEl.classList.toggle("full-screen", isCollapsed);
            btn.innerText = isCollapsed ? "Show Table" : "Hide Table";
            
            setTimeout(() => {{
                cy.resize();
                cyFitSmooth();
            }}, 160);
        }}

        function cyFitSmooth() {{
            cy.animate({{
                fit: {{ els: cy.elements().not('.hidden-node'), padding: 40 }},
                maxZoom: 1.2,
                duration: 350
            }});
        }}

        function updateInspector(nodeData) {{
            const lockBtn = document.getElementById("lock-btn");
            if (!nodeData || !nodeData.parent) {{
                document.getElementById("insp-col").innerText = "None";
                document.getElementById("insp-tbl").innerText = "--";
                document.getElementById("insp-inputs").innerText = "--";
                document.getElementById("insp-fx").innerText = "--";
                document.getElementById("insp-filter").innerText = "--";
                lockBtn.style.display = "none";
                return;
            }}
            
            document.getElementById("insp-col").innerText = nodeData.raw_name;
            document.getElementById("insp-tbl").innerText = `${{nodeData.table}} (${{nodeData.stage.toUpperCase()}})`;
            document.getElementById("insp-inputs").innerText = (nodeData.source_inputs || [nodeData.raw_name]).join(", ");
            document.getElementById("insp-fx").innerText = nodeData.formula || "Direct Mapping";
            document.getElementById("insp-filter").innerText = nodeData.filter || "None";
            
            lockBtn.style.display = "inline-block";
            if (lockedNodeId === nodeData.id) {{
                lockBtn.innerText = "Unlock Target";
                lockBtn.classList.add("locked");
            }} else {{
                lockBtn.innerText = "Lock Target (Pin)";
                lockBtn.classList.remove("locked");
            }}
        }}

        function toggleLockNode() {{
            if (!activeNodeId) return;
            if (lockedNodeId === activeNodeId) {{
                lockedNodeId = null;
            }} else {{
                lockedNodeId = activeNodeId;
            }}
            activateLineagePath(activeNodeId, false);
        }}

        function resetHighlight() {{
            lockedNodeId = null;
            activeNodeId = null;
            cy.elements().removeClass('dimmed highlighted hidden-node locked-target highlighted-parent');
            document.querySelectorAll("tr").forEach(tr => {{
                tr.classList.remove("active-row", "hidden-row");
            }});
            document.getElementById("search-input").value = "";
            updateInspector(null);
            
            cy.layout(dagreLayoutConfig).run();
        }}

        function filterTable() {{
            const query = document.getElementById("search-input").value.toLowerCase();
            document.querySelectorAll("#table-body tr").forEach(tr => {{
                const text = tr.innerText.toLowerCase();
                tr.style.display = text.includes(query) ? "" : "none";
            }});
        }}

        function activateLineagePath(nodeId, panToNode = true) {{
            const node = cy.getElementById(nodeId);
            if (!node || node.empty() || !node.data('parent')) return;
            
            activeNodeId = nodeId;
            updateInspector(node.data());
            
            let activeElements;
            if (lockedNodeId && lockedNodeId !== nodeId) {{
                const lockedNode = cy.getElementById(lockedNodeId);
                const ancestorsOfLocked = lockedNode.add(lockedNode.predecessors());
                const activeTree = node.add(node.predecessors()).add(node.successors());
                activeElements = activeTree.intersection(ancestorsOfLocked);
                activeElements = activeElements.add(lockedNode).add(node);
            }} else {{
                activeElements = node.add(node.predecessors()).add(node.successors());
            }}

            const activeParents = activeElements.nodes().map(n => n.parent());
            const keepVisible = activeElements.add(activeParents);
            const isolateMode = document.getElementById("isolate-toggle").checked;
            
            cy.elements().removeClass('dimmed highlighted hidden-node locked-target highlighted-parent');
            
            // HIGHLIGHT PARENT CONTAINER TABLE/STAGE
            const parentTableNode = node.parent();
            if (parentTableNode && !parentTableNode.empty()) {{
                parentTableNode.addClass('highlighted-parent');
            }}

            if (lockedNodeId) {{
                cy.getElementById(lockedNodeId).addClass('locked-target');
            }}

            if (isolateMode) {{
                cy.elements().not(keepVisible).addClass('hidden-node');
                activeElements.addClass('highlighted');
                
                runCompactLayout();
            }} else {{
                cy.elements().not(activeElements).addClass('dimmed');
                activeElements.addClass('highlighted');
                if (panToNode) {{
                    cyFitSmooth();
                }}
            }}

            const activeIds = new Set(activeElements.map(el => el.id()));
            document.querySelectorAll("#table-body tr").forEach(tr => {{
                tr.classList.remove("active-row");
                const rowNodeId = tr.id.replace("row-", "");
                if (isolateMode) {{
                    tr.classList.toggle("hidden-row", !activeIds.has(rowNodeId));
                }} else {{
                    tr.classList.remove("hidden-row");
                }}
            }});
            
            const selectedRow = document.getElementById("row-" + nodeId);
            if (selectedRow) {{
                selectedRow.classList.add("active-row");
                selectedRow.scrollIntoView({{ behavior: "smooth", block: "nearest" }});
            }}
        }}

        cy.on('tap', 'node[parent]', function(evt) {{
            activateLineagePath(evt.target.id(), false);
        }});

        cy.on('tap', function(evt) {{
            if (evt.target === cy) {{
                resetHighlight();
            }}
        }});

        cy.ready(() => {{ cyFitSmooth(); }});
    </script>
</body>
</html>"""

